// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  USER
  ADMIN
  SUPER_ADMIN
}

enum SubscriptionPlan {
  FREE
  STARTER
  PRO
  ULTIMATE
}

enum SubscriptionStatus {
  ACTIVE
  CANCELED
  PAST_DUE
  TRIALING
  PAUSED
  EXPIRED
}

enum PaymentProvider {
  STRIPE
  PAYPAL
}

enum PaymentStatus {
  PENDING
  COMPLETED
  FAILED
  REFUNDED
  CANCELED
}

enum UserStatus {
  WAITLIST
  INVITED
  ACTIVE
  UNSUBSCRIBED
}

enum AuthProvider {
  EMAIL
  GOOGLE
}

model User {
  id                     String     @id @default(uuid())
  email                  String     @unique
  password               String? // null for Google-only accounts
  fullName               String?
  phone                  String?
  address                String?
  avatar                 String?
  role                   Role       @default(USER)
  userStatus             UserStatus @default(WAITLIST)
  isEmailVerified        Boolean    @default(false)
  emailVerificationToken String?
  emailVerificationOtp   String?
  otpExpires             DateTime?
  passwordResetToken     String?
  passwordResetExpires   DateTime?
  lastLogin              DateTime?

  // Auth provider (email/password vs Google / Firebase)
  authProvider AuthProvider @default(EMAIL)
  firebaseUid  String?      @unique

  subscriptionPlan      SubscriptionPlan   @default(FREE)
  subscriptionStatus    SubscriptionStatus @default(ACTIVE)
  subscriptionStartDate DateTime?
  subscriptionEndDate   DateTime?
  trialEndsAt           DateTime?
  stripeCustomerId      String?            @unique
  paypalSubscriptionId  String?
  currentPeriodEnd      DateTime?
  cancelAtPeriodEnd     Boolean            @default(false)

  dailyAiMessagesUsed Int      @default(0)
  dailyPlansGenerated Int      @default(0)
  lastUsageReset      DateTime @default(now())

  onboardingCompleted Boolean @default(false)
  onboardingStep      Int     @default(0)

  referralCode    String? @unique
  referredBy      String?
  referralCredits Int     @default(0)
  referralCount   Int     @default(0)

  // Email preferences
  isUnsubscribed Boolean   @default(false)
  unsubscribedAt DateTime?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  goals                Goal[]
  dailyPlans           DailyPlan[]
  weeklyPlans          WeeklyPlan[]
  monthlyPlans         MonthlyPlan[]
  plans                Plan[]
  habits               Habit[]
  tasks                Task[]
  plannerItems         PlannerItem[]
  aiChatLogs           AiChatLog[]
  aiRecommendations    AiRecommendation[]
  payments             Payment[]
  notifications        Notification[]
  settings             UserSettings?
  activityLogs         ActivityLog[]
  supportConversations SupportConversation[]
  analytics            UserAnalytics[]
  feedbacks            Feedback[]
  conversations        Conversation[]
  tickets              Ticket[]
  adminActions         AdminAction[]

  @@index([email])
  @@index([subscriptionPlan])
  @@index([subscriptionStatus])
  @@index([referralCode])
  @@index([firebaseUid])
  @@index([authProvider])
}

model Conversation {
  id        String   @id @default(uuid())
  title     String   @default("New Conversation")
  userId    String
  type      String   @default("chat") // "chat", "daily-plan", "weekly-plan", "monthly-plan"
  pinned    Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages Message[]

  @@index([userId])
  @@index([type])
  @@index([userId, pinned])
  @@map("conversations")
}

model Message {
  id             String   @id @default(uuid())
  conversationId String
  role           String // "user" or "assistant"
  content        String   @db.Text
  timestamp      DateTime @default(now())
  tokensUsed     Int?
  model          String?

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId])
  @@index([timestamp])
  @@map("messages")
}

model UserSettings {
  id     String @id @default(uuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  wakeTime               String @default("07:00")
  sleepTime              String @default("23:00")
  productivityHoursStart String @default("09:00")
  productivityHoursEnd   String @default("17:00")
  timezone               String @default("UTC")

  workDays        String[] @default(["Monday", "Tuesday", "Wednesday", "Thursday", "Friday"])
  workHoursPerDay Int      @default(8)

  enableEmailReminders Boolean @default(true)
  enablePushReminders  Boolean @default(true)
  reminderFrequency    String  @default("daily")
  morningReminderTime  String  @default("08:00")
  eveningReminderTime  String  @default("20:00")

  aiTone                    String @default("friendly") // strict, friendly, therapist, coach, productivity, fitness
  aiVerbosity               String @default("balanced")
  preferredCoachPersonality String @default("Friendly Mentor")

  // Onboarding profile (post-register setup wizard)
  focusAreas           String[] @default([])
  primaryFocus         String?
  routineType          String?
  aiCommunicationStyle String?

  darkMode   Boolean @default(false)
  language   String  @default("en")
  dateFormat String  @default("MM/DD/YYYY")

  shareDataForImprovement Boolean @default(true)
  showInLeaderboard       Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

enum PlanType {
  DAILY
  WEEKLY
  MONTHLY
  TASK
}

enum PlanCategory {
  WORK
  PERSONAL
  HEALTH
}

enum PlanPriority {
  LOW
  MEDIUM
  HIGH
}

enum PlanStatusEnum {
  TODO
  IN_PROGRESS
  DONE
}

enum GoalCategory {
  CAREER
  HEALTH
  FINANCE
  PERSONAL
  EDUCATION
}

enum GoalStatus {
  ACTIVE
  COMPLETED
  PAUSED
  ARCHIVED
}

enum GoalPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum ItemSource {
  AI
  MANUAL
}

model Goal {
  id     String @id @default(uuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  title       String
  description String?      @db.Text
  category    GoalCategory
  status      GoalStatus   @default(ACTIVE)
  priority    Int          @default(5)

  // Priority label used by the UI (Low/Medium/High/Urgent)
  priorityLevel GoalPriority @default(MEDIUM)

  targetDate   DateTime?
  targetValue  Float?
  currentValue Float?
  unit         String?

  // Where the goal came from (AI generation vs manual creation)
  source ItemSource @default(MANUAL)

  // Cached progress computed from linked tasks + habits (0-100)
  progress Float @default(0)

  isMainFocus Boolean @default(false)

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  completedAt DateTime?

  // Linked items (a goal has many tasks and many habits)
  tasks  Task[]
  habits Habit[]

  @@index([userId])
  @@index([category])
  @@index([status])
}

enum PlanStatus {
  DRAFT
  ACTIVE
  COMPLETED
  ARCHIVED
}

model DailyPlan {
  id     String @id @default(uuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  date        DateTime
  title       String
  content     String     @db.Text
  aiGenerated Boolean    @default(true)
  status      PlanStatus @default(ACTIVE)

  morningRoutine String? @db.Text
  afternoonTasks String? @db.Text
  eveningRoutine String? @db.Text

  completionRate Float @default(0)
  tasksCompleted Int   @default(0)
  tasksTotal     Int   @default(0)

  // Reset tracking
  resetCount  Int       @default(0)
  lastResetAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  resets DailyPlanReset[]

  @@unique([userId, date])
  @@index([userId])
  @@index([date])
  @@index([status])
}

enum ResetReason {
  LOW_ENERGY
  UNEXPECTED_MEETINGS
  LOST_FOCUS
  PERSONAL_STUFF
  JUST_ONE_OF_THOSE_DAYS
  OTHER
}

model DailyPlanReset {
  id          String    @id @default(uuid())
  dailyPlanId String
  dailyPlan   DailyPlan @relation(fields: [dailyPlanId], references: [id], onDelete: Cascade)

  reason       ResetReason?
  customReason String?

  previousContent String @db.Text

  newContent String @db.Text

  triggerType       String  @default("manual")
  adaptationSummary String? @db.Text

  createdAt DateTime @default(now())

  @@index([dailyPlanId])
  @@index([createdAt])
}

model WeeklyPlan {
  id     String @id @default(uuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  weekStartDate DateTime
  weekEndDate   DateTime
  title         String
  content       String     @db.Text
  aiGenerated   Boolean    @default(true)
  status        PlanStatus @default(ACTIVE)

  weeklyGoals String?  @db.Text
  focusAreas  String[] @default([])

  completionRate Float @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([weekStartDate])
  @@index([status])
}

model MonthlyPlan {
  id     String @id @default(uuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  monthStartDate DateTime
  monthEndDate   DateTime
  title          String
  content        String     @db.Text
  aiGenerated    Boolean    @default(true)
  status         PlanStatus @default(ACTIVE)

  monthlyGoals String?  @db.Text
  milestones   String[] @default([])

  completionRate Float @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([monthStartDate])
  @@index([status])
}

model Plan {
  id     String @id @default(uuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  title       String
  description String?  @db.Text
  planType    PlanType // DAILY, WEEKLY, MONTHLY, TASK

  parentPlanId String?
  parentPlan   Plan?   @relation("PlanHierarchy", fields: [parentPlanId], references: [id], onDelete: Cascade)
  childPlans   Plan[]  @relation("PlanHierarchy")

  startDate DateTime
  dueDate   DateTime?

  category PlanCategory
  priority PlanPriority
  status   PlanStatusEnum @default(TODO)

  isManuallyCreated Boolean   @default(true)
  completedAt       DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([planType])
  @@index([parentPlanId])
  @@index([category])
  @@index([priority])
  @@index([status])
  @@index([startDate])
  @@index([dueDate])
}

enum HabitFrequency {
  DAILY
  WEEKLY
  MONTHLY
}

enum HabitDifficulty {
  EASY
  MEDIUM
  HARD
}

enum HabitStatus {
  ACTIVE
  PAUSED
  COMPLETED
}

enum HabitCategory {
  CAREER
  HEALTH
  FINANCE
  FITNESS
  WELLNESS
  PRODUCTIVITY
  PERSONAL
  EDUCATION
}

model Habit {
  id     String @id @default(uuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  name        String
  description String?         @db.Text
  category    HabitCategory
  frequency   HabitFrequency  @default(DAILY)
  difficulty  HabitDifficulty @default(MEDIUM)

  targetDays        String[] @default([])
  targetTimesPerDay Int      @default(1)
  reminderTime      String?

  currentStreak    Int @default(0)
  longestStreak    Int @default(0)
  totalCompletions Int @default(0)

  isActive    Boolean     @default(true)
  status      HabitStatus @default(ACTIVE)
  aiSuggested Boolean     @default(false)

  // Where the habit came from (AI generation vs manual creation)
  source ItemSource @default(MANUAL)

  // Optional parent goal (a habit may belong to one goal or be standalone)
  goalId String?
  goal   Goal?   @relation(fields: [goalId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  completions  HabitCompletion[]
  plannerItems PlannerItem[]
  timeSlots    HabitTimeSlot[]

  @@index([userId])
  @@index([category])
  @@index([isActive])
  @@index([status])
  @@index([goalId])
}

// Distinct From/To windows when a habit is done more than once per day.
// Never collapse these into one combined range.
model HabitTimeSlot {
  id         String @id @default(uuid())
  habitId    String
  habit      Habit  @relation(fields: [habitId], references: [id], onDelete: Cascade)

  fromTime   String // "07:00" (24h)
  toTime     String // "07:15"
  orderIndex Int    @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  completions  HabitCompletion[]
  plannerItems PlannerItem[]

  @@unique([habitId, orderIndex])
  @@index([habitId])
  @@map("habit_time_slots")
}

model HabitCompletion {
  id      String @id @default(uuid())
  habitId String
  habit   Habit  @relation(fields: [habitId], references: [id], onDelete: Cascade)

  completedAt DateTime @default(now())
  date        DateTime
  notes       String?  @db.Text

  // Which From/To slot this check-in belongs to (null = legacy / whole-day)
  timeSlotId String?
  timeSlot   HabitTimeSlot? @relation(fields: [timeSlotId], references: [id], onDelete: SetNull)

  @@index([habitId])
  @@index([date])
  @@index([timeSlotId])
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  COMPLETED
  CANCELED
  SKIPPED
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum TaskSource {
  AI_GENERATED
  MANUAL
  FROM_GOAL
  FROM_HABIT
  FROM_PLAN
}

model Task {
  id     String @id @default(uuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  title       String
  description String?      @db.Text
  status      TaskStatus   @default(TODO)
  priority    TaskPriority @default(MEDIUM)

  dueDate          DateTime?
  dueTime          String?
  estimatedMinutes Int?
  actualMinutes    Int?
  scheduledDate    DateTime?

  category GoalCategory?
  tags     String[]      @default([])

  aiGenerated      Boolean    @default(false)
  source           TaskSource @default(MANUAL)
  aiRecommendation String?    @db.Text
  difficultyLevel  Int?       @default(5)

  parentTaskId  String?
  goalId        String?
  habitId       String?
  dailyPlanId   String?
  weeklyPlanId  String?
  monthlyPlanId String?

  completionRate Float    @default(0)
  skipCount      Int      @default(0)
  skipReasons    String[] @default([])

  originalEstimate Int?
  aiAdjusted       Boolean @default(false)
  adjustmentReason String? @db.Text

  isRecurring       Boolean  @default(false)
  recurrencePattern String?
  recurrenceDays    String[] @default([])

  currentStreak   Int @default(0)
  completionCount Int @default(0)

  notes               String? @db.Text
  energyLevelRequired String?
  contextNeeded       String?

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  completedAt DateTime?
  startedAt   DateTime?
  canceledAt  DateTime?

  parentTask Task?  @relation("TaskSubtasks", fields: [parentTaskId], references: [id], onDelete: Cascade)
  subtasks   Task[] @relation("TaskSubtasks")

  // Optional parent goal (a task may belong to one goal or be standalone)
  goal Goal? @relation(fields: [goalId], references: [id], onDelete: SetNull)

  // Planner schedule placements for this task
  plannerItems PlannerItem[]

  @@index([userId])
  @@index([status])
  @@index([dueDate])
  @@index([priority])
  @@index([category])
  @@index([aiGenerated])
  @@index([source])
  @@index([goalId])
  @@index([dailyPlanId])
  @@index([scheduledDate])
  @@index([isRecurring])
}

enum PlannerItemType {
  TASK
  HABIT
}

enum PlannerViewType {
  DAILY
  WEEKLY
  MONTHLY
}

// Planner is the scheduling layer. It does NOT own task/habit content.
// It only places existing tasks/habits into date + time slots.
model PlannerItem {
  id     String @id @default(uuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  itemType PlannerItemType

  // One of these is set depending on itemType
  taskId  String?
  task    Task?   @relation(fields: [taskId], references: [id], onDelete: Cascade)
  habitId String?
  habit   Habit?  @relation(fields: [habitId], references: [id], onDelete: Cascade)

  // When itemType is HABIT, optionally pin this placement to one From/To slot
  habitTimeSlotId String?
  habitTimeSlot   HabitTimeSlot? @relation(fields: [habitTimeSlotId], references: [id], onDelete: SetNull)

  // Scheduling placement
  date      DateTime
  startTime String? // "10:00" (24h format)
  endTime   String? // "10:45"
  orderIndex Int    @default(0)

  viewType PlannerViewType @default(DAILY)

  // Planner-level completion (does not change the underlying task/habit)
  isCompleted Boolean @default(false)

  // Marks placements created/adjusted by the Planner AI
  aiScheduled Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([date])
  @@index([itemType])
  @@index([taskId])
  @@index([habitId])
  @@index([habitTimeSlotId])
  @@index([viewType])
}

enum AiChatRole {
  USER
  ASSISTANT
  SYSTEM
}

model AiChatLog {
  id     String @id @default(uuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  role        AiChatRole
  message     String     @db.Text
  messageType String     @default("chat")

  tokensUsed Int?
  model      String @default("gpt-4")

  conversationId String?

  createdAt DateTime @default(now())

  @@index([userId])
  @@index([conversationId])
  @@index([createdAt])
}

enum RecommendationType {
  HABIT
  TASK
  GOAL
  PLAN_ADJUSTMENT
  LIFESTYLE
  PRODUCTIVITY_TIP
  HEALTH_TIP
}

model AiRecommendation {
  id     String @id @default(uuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  type        RecommendationType
  title       String
  description String             @db.Text
  reasoning   String?            @db.Text

  isApplied   Boolean @default(false)
  isDismissed Boolean @default(false)

  priority Int @default(5)

  createdAt   DateTime  @default(now())
  appliedAt   DateTime?
  dismissedAt DateTime?

  @@index([userId])
  @@index([type])
  @@index([isApplied])
}

model Payment {
  id     String @id @default(uuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  amount   Float
  currency String          @default("USD")
  status   PaymentStatus
  provider PaymentProvider

  stripePaymentIntentId   String?
  stripeCheckoutSessionId String? @unique
  stripeInvoiceId         String?
  paypalOrderId           String?
  paypalSubscriptionId    String?

  plan          SubscriptionPlan
  billingPeriod String?

  description String?
  receiptUrl  String?

  paidAt     DateTime?
  refundedAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@index([userId])
  @@index([status])
  @@index([provider])
  @@index([createdAt])
}

enum NotificationType {
  WELCOME
  EMAIL_VERIFICATION
  SUBSCRIPTION_CONFIRMATION
  PAYMENT_FAILED
  TRIAL_ENDING
  CANCELLATION_CONFIRMATION
  PASSWORD_RESET
  PLAN_UPDATED
  MONTHLY_SUMMARY
  DAILY_REMINDER
  HABIT_REMINDER
  STREAK_NOTIFICATION
  GOAL_MILESTONE
  WEEKLY_REVIEW
  REFERRAL_REWARD
  ANNOUNCEMENT
  FEATURE_RELEASE
}

enum NotificationChannel {
  EMAIL
  IN_APP
  PUSH
}

enum NotificationStatus {
  PENDING
  SENT
  FAILED
  READ
}

model Notification {
  id     String @id @default(uuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  type    NotificationType
  channel NotificationChannel
  status  NotificationStatus  @default(PENDING)

  title   String
  message String @db.Text

  data Json?

  scheduledFor DateTime?
  sentAt       DateTime?
  readAt       DateTime?

  createdAt DateTime @default(now())

  @@index([userId])
  @@index([type])
  @@index([status])
  @@index([scheduledFor])
}

enum ActivityType {
  USER_LOGIN
  USER_LOGOUT
  PLAN_CREATED
  PLAN_UPDATED
  PLAN_COMPLETED
  HABIT_CREATED
  HABIT_COMPLETED
  TASK_CREATED
  TASK_COMPLETED
  GOAL_CREATED
  GOAL_COMPLETED
  SUBSCRIPTION_STARTED
  SUBSCRIPTION_CANCELED
  SUBSCRIPTION_UPGRADED
  SUBSCRIPTION_DOWNGRADED
  PAYMENT_SUCCEEDED
  PAYMENT_FAILED
  AI_CHAT
  AI_RECOMMENDATION
  SETTINGS_UPDATED
  PASSWORD_CHANGED
  EMAIL_VERIFIED
}

model ActivityLog {
  id     String @id @default(uuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  type        ActivityType
  description String
  metadata    Json?

  ipAddress String?
  userAgent String?

  createdAt DateTime @default(now())

  @@index([userId])
  @@index([type])
  @@index([createdAt])
}

enum SupportStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  CLOSED
}

model SupportConversation {
  id     String  @id @default(uuid())
  userId String? // Optional for guest support
  user   User?   @relation(fields: [userId], references: [id], onDelete: Cascade)

  sessionId   String? @unique // For guest users
  threadId    String? // OpenAI Assistant thread ID
  assistantId String? // OpenAI Assistant ID used

  subject  String
  status   SupportStatus @default(OPEN)
  priority TaskPriority  @default(MEDIUM)
  category String? // billing, features, troubleshooting, etc.

  isAiHandled       Boolean   @default(true)
  needsHumanSupport Boolean   @default(false)
  escalated         Boolean   @default(false)
  escalatedAt       DateTime?
  resolved          Boolean   @default(false)

  userSatisfactionRating Int? // 1-5 rating
  wasHelpful             Boolean?

  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  resolvedAt DateTime?

  messages SupportMessage[]

  @@index([userId])
  @@index([sessionId])
  @@index([status])
  @@index([category])
  @@index([isAiHandled])
}

model SupportMessage {
  id             String              @id @default(uuid())
  conversationId String
  conversation   SupportConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  role       String // user, assistant, system
  isFromUser Boolean
  isFromAi   Boolean @default(false)
  message    String  @db.Text

  confidence     Float? // AI confidence score 0-1
  tokensUsed     Int?
  responseTimeMs Int?

  attachments String[] @default([])
  metadata    Json? // Additional context

  createdAt DateTime @default(now())

  @@index([conversationId])
  @@index([role])
}

model UserAnalytics {
  id     String @id @default(uuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  date DateTime @default(now())

  loginCount             Int @default(0)
  sessionDurationMinutes Int @default(0)

  plansGenerated  Int @default(0)
  habitsCompleted Int @default(0)
  tasksCompleted  Int @default(0)
  aiMessagesCount Int @default(0)

  dailyActiveUser   Boolean @default(false)
  weeklyActiveUser  Boolean @default(false)
  monthlyActiveUser Boolean @default(false)

  completionRate Float @default(0)
  streakCount    Int   @default(0)

  @@unique([userId, date])
  @@index([userId])
  @@index([date])
}

enum FeedbackType {
  BUG
  FEATURE_REQUEST
  COMPLAINT
  SUGGESTION
  PRAISE
  OTHER
}

enum FeedbackStatus {
  NEW
  REVIEWED
  IN_PROGRESS
  COMPLETED
  DISMISSED
}

model Feedback {
  id     String @id @default(uuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  type   FeedbackType
  status FeedbackStatus @default(NEW)

  title       String
  description String @db.Text

  upvotes Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([type])
  @@index([status])
}

enum AnnouncementType {
  INFO
  UPDATE
  FEATURE
  MAINTENANCE
  PROMOTION
}

enum AnnouncementStatus {
  DRAFT
  SENT
}

enum TargetType {
  ALL_USERS
  FREE_USERS
  PAID_USERS
  SPECIFIC_PLAN
  EVERYONE
  ALL_INCLUDING_WAITLIST
}

model Announcement {
  id String @id @default(uuid())

  title   String
  message String           @db.Text
  type    AnnouncementType @default(INFO)

  targetType  TargetType         @default(ALL_USERS)
  targetPlans SubscriptionPlan[] @default([])

  status AnnouncementStatus @default(DRAFT)

  createdBy String // Admin ID
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  scheduledAt DateTime?
  sentAt      DateTime?

  isActive Boolean @default(true)
  isPinned Boolean @default(false)

  expiresAt DateTime?

  userNotifications UserNotification[]

  @@index([status])
  @@index([createdBy])
  @@index([createdAt])
  @@index([scheduledAt])
}

model UserNotification {
  id             String @id @default(uuid())
  userId         String
  announcementId String

  isRead Boolean   @default(false)
  readAt DateTime?

  createdAt DateTime @default(now())

  announcement Announcement @relation(fields: [announcementId], references: [id], onDelete: Cascade)

  @@unique([userId, announcementId])
  @@index([userId])
  @@index([announcementId])
  @@index([isRead])
  @@index([userId, isRead])
  @@map("user_notifications")
}

model MotivationalMessage {
  id String @id @default(uuid())

  message  String @db.Text
  category String @default("general")

  isActive Boolean @default(true)

  createdAt DateTime @default(now())

  @@index([category])
  @@index([isActive])
}

model Referral {
  id String @id @default(uuid())

  referrerUserId String // User who referred
  referredUserId String

  referralCode   String
  rewardCredited Boolean @default(false)
  rewardAmount   Int     @default(0)

  createdAt  DateTime  @default(now())
  creditedAt DateTime?

  @@index([referrerUserId])
  @@index([referredUserId])
  @@index([referralCode])
}

model ReferralInvitation {
  id String @id @default(uuid())

  referrerUserId String
  invitedEmail   String
  referralCode   String

  isRegistered     Boolean @default(false)
  registeredUserId String?

  sentAt       DateTime  @default(now())
  registeredAt DateTime?

  @@index([referrerUserId])
  @@index([invitedEmail])
  @@index([referralCode])
}

enum RoadmapStatus {
  PLANNED
  IN_DEVELOPMENT
  TESTING
  RELEASED
  CANCELED
}

enum TicketStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  CLOSED
}

enum TicketPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

model RoadmapItem {
  id String @id @default(uuid())

  title       String
  description String        @db.Text
  status      RoadmapStatus @default(PLANNED)

  upvotes Int @default(0)

  estimatedRelease DateTime?
  actualRelease    DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
}

model PricingSettings {
  id String @id @default(uuid())

  plan SubscriptionPlan @unique

  monthlyPrice Float
  yearlyPrice  Float?

  features String[] @default([])

  dailyAiMessageLimit Int?
  dailyPlanLimit      Int?
  maxGoals            Int?
  maxHabits           Int?

  isActive Boolean @default(true)

  updatedAt DateTime @updatedAt
}

model Ticket {
  id         String         @id @default(uuid())
  ticketId   String         @unique // Format: TXT-001, TXT-002, etc.
  userId     String
  subject    String
  status     TicketStatus   @default(OPEN)
  priority   TicketPriority @default(MEDIUM)
  assignedTo String? // Admin user ID
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt
  closedAt   DateTime?

  user     User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages TicketMessage[]

  @@index([userId])
  @@index([status])
  @@index([priority])
  @@index([assignedTo])
  @@index([createdAt])
  @@map("tickets")
}

model TicketMessage {
  id          String   @id @default(uuid())
  ticketId    String
  senderId    String
  message     String   @db.Text
  isFromAdmin Boolean  @default(false)
  isRead      Boolean  @default(false)
  createdAt   DateTime @default(now())

  ticket Ticket @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  @@index([ticketId])
  @@index([senderId])
  @@index([isRead])
  @@index([createdAt])
  @@map("ticket_messages")
}

model PricingConfig {
  id                   String           @id @default(uuid())
  plan                 SubscriptionPlan @unique
  monthlyPrice         Float
  yearlyPrice          Float
  stripePriceIdMonthly String? // Stripe Price ID for monthly subscription
  stripePriceIdYearly  String? // Stripe Price ID for yearly subscription
  features             Json // Store features as JSON array
  limits               Json // Store limits like {aiMessages: 1000, habits: 5}
  isActive             Boolean          @default(true)
  updatedAt            DateTime         @updatedAt
  updatedBy            String? // Admin user ID who made the change
  createdAt            DateTime         @default(now())

  @@map("pricing_configs")
}

model AdminAction {
  id           String   @id @default(uuid())
  adminId      String
  admin        User     @relation(fields: [adminId], references: [id])
  action       String
  targetUserId String?
  details      Json?
  createdAt    DateTime @default(now())

  @@index([adminId])
  @@index([action])
  @@index([createdAt])
  @@map("admin_actions")
}

model SupportKnowledgeBase {
  id              String   @id @default(uuid())
  category        String
  question        String   @db.Text
  answer          String   @db.Text
  keywords        String[] @default([])
  relatedArticles String[] @default([])

  isActive        Boolean @default(true)
  viewCount       Int     @default(0)
  helpfulCount    Int     @default(0)
  notHelpfulCount Int     @default(0)

  priority Int @default(0) // Higher priority = shown first

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  updatedBy String? // Admin user ID

  @@index([category])
  @@index([isActive])
  @@index([priority])
  @@map("support_knowledge_base")
}

model SupportAnalytics {
  id   String   @id @default(uuid())
  date DateTime @default(now())

  totalConversations     Int @default(0)
  aiHandledConversations Int @default(0)
  escalatedConversations Int @default(0)
  resolvedConversations  Int @default(0)

  averageResponseTimeMs    Int    @default(0)
  averageResolutionTimeMs  Int    @default(0)
  averageSatisfactionScore Float?

  topCategory        String?
  mostAskedQuestions Json? // Array of question IDs

  @@unique([date])
  @@map("support_analytics")
}

model ContactSubmission {
  id        String   @id @default(uuid())
  fullName  String
  email     String
  subject   String
  message   String   @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([email])
  @@index([createdAt])
  @@map("contact_submissions")
}
