{
  "info": {
    "name": "Admin Task Management API",
    "description": "Complete admin endpoints for task management system",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:5000/api/v1",
      "type": "string"
    },
    {
      "key": "adminToken",
      "value": "YOUR_ADMIN_JWT_TOKEN_HERE",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "Admin Task Management",
      "item": [
        {
          "name": "1. Get All Tasks (Paginated)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{adminToken}}",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/admin/tasks?page=1&limit=20",
              "host": ["{{baseUrl}}"],
              "path": ["admin", "tasks"],
              "query": [
                {
                  "key": "page",
                  "value": "1"
                },
                {
                  "key": "limit",
                  "value": "20"
                },
                {
                  "key": "status",
                  "value": "COMPLETED",
                  "disabled": true
                },
                {
                  "key": "priority",
                  "value": "HIGH",
                  "disabled": true
                },
                {
                  "key": "aiGenerated",
                  "value": "true",
                  "disabled": true
                },
                {
                  "key": "search",
                  "value": "workout",
                  "disabled": true
                },
                {
                  "key": "userId",
                  "value": "",
                  "disabled": true
                }
              ]
            }
          }
        },
        {
          "name": "2. Get User's Tasks",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{adminToken}}",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/admin/users/:userId/tasks?limit=50",
              "host": ["{{baseUrl}}"],
              "path": ["admin", "users", ":userId", "tasks"],
              "query": [
                {
                  "key": "limit",
                  "value": "50"
                },
                {
                  "key": "status",
                  "value": "COMPLETED",
                  "disabled": true
                }
              ],
              "variable": [
                {
                  "key": "userId",
                  "value": "USER_ID_HERE"
                }
              ]
            }
          }
        },
        {
          "name": "3. Get Task Analytics Dashboard",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{adminToken}}",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/admin/tasks/analytics",
              "host": ["{{baseUrl}}"],
              "path": ["admin", "tasks", "analytics"],
              "query": [
                {
                  "key": "startDate",
                  "value": "2026-01-01",
                  "disabled": true
                },
                {
                  "key": "endDate",
                  "value": "2026-01-31",
                  "disabled": true
                }
              ]
            }
          }
        },
        {
          "name": "4. Get AI Performance Metrics",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{adminToken}}",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/admin/tasks/ai-performance?days=30",
              "host": ["{{baseUrl}}"],
              "path": ["admin", "tasks", "ai-performance"],
              "query": [
                {
                  "key": "days",
                  "value": "30"
                }
              ]
            }
          }
        },
        {
          "name": "5. Get System Health",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{adminToken}}",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/admin/tasks/system-health",
              "host": ["{{baseUrl}}"],
              "path": ["admin", "tasks", "system-health"]
            }
          }
        },
        {
          "name": "6. Update Task (Admin)",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{adminToken}}",
                "type": "text"
              },
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"COMPLETED\",\n  \"notes\": \"Marked complete by admin support\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/admin/tasks/:taskId",
              "host": ["{{baseUrl}}"],
              "path": ["admin", "tasks", ":taskId"],
              "variable": [
                {
                  "key": "taskId",
                  "value": "TASK_ID_HERE"
                }
              ]
            }
          }
        },
        {
          "name": "7. Delete Task (Admin)",
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{adminToken}}",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/admin/tasks/:taskId",
              "host": ["{{baseUrl}}"],
              "path": ["admin", "tasks", ":taskId"],
              "variable": [
                {
                  "key": "taskId",
                  "value": "TASK_ID_HERE"
                }
              ]
            }
          }
        },
        {
          "name": "8. Export Tasks to CSV",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{adminToken}}",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/admin/tasks/export",
              "host": ["{{baseUrl}}"],
              "path": ["admin", "tasks", "export"],
              "query": [
                {
                  "key": "userId",
                  "value": "",
                  "disabled": true
                },
                {
                  "key": "status",
                  "value": "COMPLETED",
                  "disabled": true
                },
                {
                  "key": "startDate",
                  "value": "2026-01-01",
                  "disabled": true
                },
                {
                  "key": "endDate",
                  "value": "2026-01-31",
                  "disabled": true
                }
              ]
            }
          }
        }
      ]
    },
    {
      "name": "Authentication",
      "item": [
        {
          "name": "Login as Admin",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200) {",
                  "    const jsonData = pm.response.json();",
                  "    pm.collectionVariables.set(\"adminToken\", jsonData.token);",
                  "    console.log(\"Admin token saved:\", jsonData.token);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin@example.com\",\n  \"password\": \"your-password\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/login",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "login"]
            }
          }
        }
      ]
    }
  ]
}
